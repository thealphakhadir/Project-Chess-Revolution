    public static void main(String[] args) throws Exception {
        System.out.println("=== Module 3c · Luminaries (Brilliant Move Counter) ===\n");

        // --- synthetic transcripts (production: Codex replay supplies these) ---
        String[] sansA = {
            "e4","e5","Nf3","Nc6","Bb5","a6","Ba4","Nf6","O-O","Be7",
            "Re1","b5","Bb3","d6","c3","O-O","h3","Nb8","d4","Nbd7",
            "Nbd2","Bb7","Bc2","Re8","Nf1","Bf8","Ng3","g6"
        };
        String[] sansB = {
            "e4","c5","Nf3","d6","d4","cxd4","Nxd4","Nf6","Nc3","a6",
            "Be3","e5","Nce2","Be7","Qd2","O-O","O-O-O","Qc7","Kb1","Be6",
            "f3","Nbd7","g4","b5"
        };
        GameTranscript gameA = transcript("g-2026-10-07-042", "abdul", "opponent-9", sansA);
        // In game B, Abdul plays the Black side of a Sicilian.
        GameTranscript gameB = transcript("g-2026-10-07-051", "opponent-4", "abdul", sansB);

        Path file = Path.of("/tmp/luminaries-demo.txt");
        Files.deleteIfExists(file);
        Luminaries module = new Luminaries(new Ledger(file), new StubNarrative(), new ConsoleBridge());

        // --- Part 1 in action: two games analysed ------------------------------
        System.out.println("--- Ledger ingestion (Part 1) ---");
        // Game A: ply 21 (White's Nbd2) brilliant, 0.6 -> 2.0
        int a = module.submitAnalysedGame(gameA, List.of(21), Map.of(20, 0.6, 21, 2.0, 22, 1.8));
        System.out.printf("game A: %d new entr%s%n", a, a == 1 ? "y" : "ies");
        // Game B (Abdul as Black): ply 14 ...Be7 gains 1.7 (eval 0.3 -> -1.4 in White's view),
        // ply 24 ...b5 gains 3.4 (eval 0.4 -> -3.0).
        int b = module.submitAnalysedGame(gameB, List.of(14, 24),
                Map.of(13, 0.3, 14, -1.4, 23, 0.4, 24, -3.0));
        System.out.printf("game B: %d new entries%n", b);
        // Same game re-analysed later -> idempotent, no double count.
        int dup = module.submitAnalysedGame(gameA, List.of(21), Map.of(20, 0.6, 21, 2.0, 22, 1.8));
        System.out.printf("re-analyse game A: %d new entries (dedup working: expect 0)%n", dup);
        System.out.printf("Lifetime count: %d%n%n", module.lifetimeCount("abdul"));

        // --- Part 2 in action: the tab -----------------------------------------
        System.out.println("--- The Tab (Part 2) ---");
        LuminariesTab tab = module.tabFor("abdul");
        System.out.println(tab.header());
        List<TabEntryView> views = tab.entries();
        for (int i = 0; i < views.size(); i++) {
            TabEntryView v = views.get(i);
            System.out.printf("%d. %s%n", i + 1, v.title());
            System.out.printf("   %s%n", v.description());
            System.out.printf("   (%s · click title -> analysis mode)%n", v.moveLabel());
        }

        // Click the top entry's title -> analysis mode + repeat button.
        System.out.println("\n--- Click a title -> Sagacious analysis mode ---");
        AnalysisSession session = tab.openEntry(views.get(0).entryId());
        session.repeat();
        session.repeat();
        System.out.printf("repeat pressed 3x total: %d viewings%n", session.repeatCount());
        session.close();

        // --- persistence round-trip ---------------------------------------------
        Luminaries reloaded = new Luminaries(new Ledger(file), new StubNarrative(), new ConsoleBridge());
        System.out.printf("%nAfter reload from file, lifetime count: %d%n", reloaded.lifetimeCount("abdul"));

        // --- the real-AI seam ----------------------------------------------------
        System.out.println("\n--- Production AI prompt (PromptNarrative) for the top entry ---");
        System.out.println(PromptNarrative.promptFor(
                reloaded.ledger.entries("abdul").get(0)));
    }

    private static GameTranscript transcript(String gameId, String whiteId, String blackId, String[] sans) {
        GameTranscript.Builder g = GameTranscript.builder()
                .gameId(gameId).whitePlayerId(whiteId).blackPlayerId(blackId);
        for (int ply = 1; ply <= sans.length; ply++) {
            // Structurally valid placeholder FEN per ply; real FENs come from Codex.
            g.addMove(sans[ply - 1],
                    FenUtils.START_POS.replace(" 0 1", " 0 " + ((ply + 1) / 2)));
        }
        return g.build();
    }
