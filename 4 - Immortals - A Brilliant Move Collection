    // =====================================================================
    // Part 2 — The tab itself
    // =====================================================================

    /** One row of the menu as the UI renders it. */
    public record TabEntryView(String entryId, String title, String description,
                               String moveLabel, String fenBefore) {}

    /** A live Sagacious-analysis view opened by clicking an entry's title. */
    public static final class AnalysisSession {
        private final SagaciousBridge bridge;
        private final BrilliantEntry entry;
        private int repeats;
        private boolean open = true;

        AnalysisSession(SagaciousBridge bridge, BrilliantEntry entry) {
            this.bridge = bridge;
            this.entry = entry;
            // Entering analysis mode: load the BEFORE position, then play the move.
            bridge.loadPosition(entry.fenBefore());
            bridge.requestAnalysis(entry.fenBefore());
            bridge.playSan(entry.san());
            repeats = 1;
        }

        /** The repeat button. Replays the move over and over. */
        public void repeat() {
            if (!open) throw new IllegalStateException("session closed");
            bridge.loadPosition(entry.fenBefore());
            bridge.playSan(entry.san());
            repeats++;
        }

        public int repeatCount() { return repeats; }
        public boolean isOpen() { return open; }

        public void close() {
            open = false;
            System.out.println("   [analysis] session closed (" + repeats + " viewing(s) of " + entry.san() + ")");
        }
    }

    /** The Luminaries tab: counter header, narrated entries, click-through. */
    public static final class LuminariesTab {
        private final String playerId;
        private final Ledger ledger;
        private final SagaciousBridge bridge;

        LuminariesTab(String playerId, Ledger ledger, SagaciousBridge bridge) {
            this.playerId = playerId;
            this.ledger = ledger;
            this.bridge = bridge;
        }

        /** Header line: the lifetime counter lives here. */
        public String header() {
            int n = ledger.lifetimeCount(playerId);
            return "✦ Luminaries — " + n + " lifetime " + (n == 1 ? "brilliancy" : "brilliancies");
        }

        /** Entries newest first; entries without a narrative yet show the move. */
        public List<TabEntryView> entries() {
            List<TabEntryView> out = new ArrayList<>();
            for (BrilliantEntry e : ledger.entries(playerId)) {
                String title = e.hasNarrative() ? e.title() : e.san() + " (move " + e.moveNumber() + ")";
                String desc = e.hasNarrative() ? e.description() : "Narrative pending…";
                String label = (e.ply() % 2 == 1 ? "White" : "Black") + " · game " + e.gameId();
                out.add(new TabEntryView(e.entryId(), title, desc, label, e.fenBefore()));
            }
            return out;
        }

        /** The hyperlink behaviour: clicking a title opens analysis mode. */
        public AnalysisSession openEntry(String entryId) {
            BrilliantEntry e = ledger.find(playerId, entryId);
            if (e == null) throw new IllegalArgumentException("no such entry: " + entryId);
            System.out.println("   [link] title clicked -> opening Sagacious analysis mode");
            return new AnalysisSession(bridge, e);
        }
    }

    // =====================================================================
    // Facade — the module's public API
    // =====================================================================

    private final Ledger ledger;
    private final NarrativeService narrative;
    private final SagaciousBridge bridge;

    public Luminaries(Ledger ledger, NarrativeService narrative, SagaciousBridge bridge) {
        this.ledger = ledger;
        this.narrative = narrative;
        this.bridge = bridge;
    }

    /**
     * End-to-end pipeline call after each analysed game: extract FENs, record
     * new entries (+1 counter each), and attach the AI narrative immediately.
     * Safe to call repeatedly for the same game — dedup makes it idempotent.
     */
    public int submitAnalysedGame(GameTranscript game, List<Integer> brilliantPlies,
                                  Map<Integer, Double> evalByPly) {
        int added = 0;
        for (BrilliantCandidate c : BrilliantExtractor.extract(game, brilliantPlies, evalByPly)) {
            if (ledger.record(c)) {
                added++;
                BrilliantEntry stored = ledger.find(c.playerId(),
                        BrilliantEntry.makeEntryId(c.playerId(), c.gameId(), c.ply()));
                NarrativeService.Narrative n = narrative.compose(stored);
                ledger.setNarrative(c.playerId(), stored.entryId(), n.title(), n.description());
            }
        }
        return added;
    }

    public int lifetimeCount(String playerId) { return ledger.lifetimeCount(playerId); }

    public LuminariesTab tabFor(String playerId) {
        return new LuminariesTab(playerId, ledger, bridge);
    }

    public Ledger ledger() { return ledger; }

