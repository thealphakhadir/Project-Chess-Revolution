        void onTapRookie();
        void onDismiss();
        void onRetry();
        void onSkip();
    }

    // =====================================================================
    // State Machine — presentation-side states & transitions
    // =====================================================================

    public enum State { IDLE, CHIMED, ACTIVATING, REVEALED, ERROR, DISMISSING }

    /**
     * Drives the presentation states. Delegates actual effects to a
     * {@link PresentationDriver} and reports readiness back to the
     * {@link DeliveryAdapter}. Timers are abstracted via {@link TimerHandle}
     * so the same logic works with real async timers (JS) or simulated ones.
     */
    public static final class StateMachine {
        private final DeliveryAdapter adapter;
        private final PresentationDriver driver;
        private final DeliveryConfig config;
        private volatile State state = State.IDLE;
        private CoachMessage current;
        private TimerHandle pendingTimer;

        StateMachine(DeliveryAdapter adapter, PresentationDriver driver, DeliveryConfig config) {
            this.adapter = adapter;
            this.driver = driver;
            this.config = config;
        }

        public State state() { return state; }

        /** Called by the adapter when it wants to fire the next chime. */
        void fireNext(CoachMessage msg) {
            if (state != State.IDLE) return;
            current = msg;
            setState(State.CHIMED);
            driver.playChime(config.chimePattern(msg.priority()));
            driver.showTapHint();
            schedule(config.tapTimeoutMs, this::onTapTimeout);
        }

        private void onTapTimeout() {
            if (state != State.CHIMED) return;
            adapter.onChimeIgnored(current);   // adapter decides re-chime vs drop
            setState(State.IDLE);
        }

        // ---- driver callbacks ----
        @Override public void onTapRookie() {
            if (state != State.CHIMED) return;
            cancelPending();
            setState(State.ACTIVATING);
            driver.startTransition();
            schedule(config.transitionMs(), this::onTransitionDone);
        }

        private void onTransitionDone() {
            if (state != State.ACTIVATING) return;
            try {
                driver.renderMessage(current);
                setState(State.REVEALED);
                adapter.onRevealed(current);
            } catch (RuntimeException ex) {
                enterError(ex.getMessage());
            }
        }

        @Override public void onDismiss() {
            if (state != State.REVEALED) return;
            beginDismiss();
        }

        private void beginDismiss() {
            setState(State.DISMISSING);
            driver.fadeOut();
            schedule(config.fadeMs(), () -> {
                setState(State.IDLE);
                adapter.advanceToNext();
            });
        }

        private void enterError(String reason) {
            setState(State.ERROR);
            driver.showError();
            if (current != null) adapter.onError(current, reason);
        }

        @Override public void onRetry() {
            if (state != State.ERROR) return;
            setState(State.ACTIVATING);
            driver.startTransition();
            schedule(config.transitionMs(), this::onTransitionDone);
        }

        @Override public void onSkip() {
            if (state != State.ERROR) return;
            if (current != null) adapter.onSkipped(current);
            setState(State.DISMISSING);
            driver.fadeOut();
            schedule(config.fadeMs(), () -> {
                setState(State.IDLE);
                adapter.advanceToNext();
            });
        }

        // ---- timer plumbing ----
        private void schedule(long ms, Runnable action) {
            cancelPending();
            pendingTimer = adapter.timers().schedule(ms, action);
        }
        private void cancelPending() {
            if (pendingTimer != null) { pendingTimer.cancel(); pendingTimer = null; }
        }
        private void setState(State s) { state = s; }
    }

    // =====================================================================
    // Timer abstraction — real async in prod, simulated in the demo
    // =====================================================================

    public interface TimerHandle { void cancel(); }

    public interface TimerService {
        TimerHandle schedule(long delayMs, Runnable action);
    }

    // =====================================================================
    // Delivery Adapter — scheduling core (WHAT + WHEN)
    // =====================================================================

    private final DeliveryConfig config;
    private final EngagementLog engagement;
    private final PriorityQueue<CoachMessage> queue;
    private CoachMessage pendingSummary;
    private final Map<Integer, Integer> rechimeCount = new LinkedHashMap<>();
    private boolean sessionActive;
    private final TimerService timers;
    private final StateMachine machine;

    public DeliveryAdapter(List<CoachMessage> messages, DeliveryConfig config,
                           PresentationDriver driver, TimerService timers) {
        this.config = config != null ? config : DeliveryConfig.defaults();
        this.engagement = new EngagementLog();
        this.timers = timers;
        this.queue = new PriorityQueue<>(Comparator
                .comparingInt((CoachMessage m) -> m.isGlobal() ? Integer.MAX_VALUE : m.moveIndex())
                .thenComparing(m -> -m.priority().rank()));
        this.machine = new StateMachine(this, driver, this.config);

        for (CoachMessage m : messages) {
            if (m.isGlobal() && m.type() == MessageType.SUMMARY) pendingSummary = m;
            else queue.offer(m);
        }
        this.sessionActive = true;
    }

    /** Kick off the session; called once after construction. */
    public void start() {
        if (!sessionActive) return;
        advanceToNext();
    }

    // ---- adapter hooks invoked by the state machine ----

    void advanceToNext() {
        if (!sessionActive) return;
        if (queue.isEmpty() && pendingSummary != null) {
            queue.offer(pendingSummary);
            pendingSummary = null;
        }
        if (queue.isEmpty()) { endSession(); return; }
        CoachMessage next = queue.peek();
        engagement.recordChime();
        machine.fireNext(next);
    }

    void onRevealed(CoachMessage m) {
        queue.poll();                       // remove the just-revealed message
        engagement.recordRevealed(m.id());
    }

    void onChimeIgnored(CoachMessage m) {
        engagement.recordIgnoredChime();
        int count = rechimeCount.merge(m.id(), 1, Integer::sum);
        if (count < config.maxRechimes()) {
            // Re-chime after cooldown (message stays queued).
            timers.schedule(config.rechimeCooldownMs(), () -> {
                if (sessionActive && !queue.isEmpty() && queue.peek().id() == m.id()) {
                    engagement.recordChime();
                    machine.fireNext(m);
                }
            });
        } else {
            // Give up: fold into summary's "also worth reviewing".
            queue.poll();
            engagement.recordSkipped(m.id());
            if (pendingSummary == null) attachOverflowNote(m);
        }
    }

    void onSkipped(CoachMessage m) {
        queue.poll();
        engagement.recordSkipped(m.id());
    }

    void onError(CoachMessage m, String reason) {
        engagement.recordError(m.id());
        // Message remains queued; retry re-attempts the same message.
    }

    private void endSession() {
        sessionActive = false;
        machine.sendSessionEndSafe();
    }

    // ---- overflow bookkeeping for dropped messages ----
    private final List<Integer> overflowMoves = new ArrayList<>();
    private void attachOverflowNote(CoachMessage m) { overflowMoves.add(m.moveIndex()); }
    public List<Integer> overflowMoves() { return List.copyOf(overflowMoves); }

    // ---- accessors ----
    public EngagementLog engagement() { return engagement; }
    public StateMachine machine() { return machine; }
    public TimerService timers() { return timers; }
    public boolean isActive() { return sessionActive; }

    // helper used by StateMachine.endSession path
    void sendSessionEndSafe() { /* routed through driver inside machine */ }

