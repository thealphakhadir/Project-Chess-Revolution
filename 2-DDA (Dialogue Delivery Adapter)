    public static void main(String[] args) {
        System.out.println("=== Rookie · Delivery Flow (simulated) ===\n");

        // A handful of messages as if produced by Module 3b(1).
        List<CoachMessage> msgs = new ArrayList<>();
        int id = 1;
        msgs.add(new CoachMessage(id++, 3,  MessageType.THEORY_NOTE,   null,
                "Around move 3 you stepped away from the Caro-Kann Defence (B12).", List.of()));
        msgs.add(new CoachMessage(id++, 14, MessageType.BLUNDER,       null,
                "Move 14 cost roughly 2.3 pawns. Position swung sharply against you.", List.of("d5")));
        msgs.add(new CoachMessage(id++, 20, MessageType.BRILLIANT,     null,
                "Move 20 was a strong choice — it improved your position notably.", List.of()));
        msgs.add(new CoachMessage(id++, 26, MessageType.TACTIC_MISSED, null,
                "On move 26 there was a fork available: knight fork on f2.", List.of("f2")));
        msgs.add(new CoachMessage(id++, CoachMessage.GLOBAL_MOVE_INDEX, MessageType.SUMMARY, null,
                "You won. Pivotal moment around move 14. Focus on avoiding flagged mistakes.", List.of()));

        DeliveryConfig cfg = DeliveryConfig.builder()
                .tapTimeoutMs(8000).transitionMs(600).fadeMs(400)
                .rechimeCooldownMs(15000).maxRechimes(2)
                .build();

        SimulatedTimers timers = new SimulatedTimers();
        // We need the driver to reference the machine, which references the adapter,
        // which needs the driver — resolve with a tiny holder.
        Holder h = new Holder();
        DeliveryAdapter adapter = new DeliveryAdapter(msgs, cfg, h.driverPlaceholder, timers);
        h.driverPlaceholder.setDelegate(adapter.machine());
        SimulatedDriver driver = new SimulatedDriver(adapter.machine());
        h.driverPlaceholder.attach(driver);

        adapter.start();

        // Script the user: tap every chime, dismiss every reveal, skip nothing.
        driveUser(timers, adapter, driver);

        System.out.println("\n--- Engagement ---");
        EngagementLog e = adapter.engagement();
        System.out.printf("chimes=%d ignored=%d tapRate=%.2f%n",
                e.totalChimes(), e.ignoredChimes(), e.tapRate());
    }

    /** Advance the simulation: fire timers, then simulate a tap/dismiss per cycle. */
    private static void driveUser(SimulatedTimers timers, DeliveryAdapter adapter, SimulatedDriver driver) {
        int guard = 0;
        while (adapter.isActive() && guard++ < 50) {
            timers.flushAll();                 // let transitions/dism
