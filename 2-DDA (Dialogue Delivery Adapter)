import java.util.ArrayList;
import java.util.Comparator;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.PriorityQueue;
import java.util.concurrent.atomic.AtomicInteger;

/**
 * Module 3b(3) — Rookie Delivery Adapter &amp; State Machine.
 *
 * <p>Self-contained build of the post-game message <em>delivery</em> layer for
 * OpenChess. It consumes the ordered {@link CoachMessage} list produced by
 * Module 3b(1) (the Message Generator) and drives them through a timed state
 * machine: chime, tap, "activating translator" transition, reveal, dismiss,
 * with a "Lost in Translation" error path.</p>
 *
 * <p><strong>Separation of concerns</strong></p>
 * <ul>
 *   <li>{@link DeliveryAdapter} owns PACE — what to deliver next, when to
 *       re-chime, when to end the session. Pure scheduling logic.</li>
 *   <li>The state machine ({@link StateMachine}) owns PRESENTATION — the
 *       visual/audio states and transitions.</li>
 *   <li>{@link PresentationDriver} is the seam between them. In production the
 *       real implementation lives in the JS/HTML UI (Web Audio chime, dialog
 *       overlay, timers); here an in-process {@link SimulatedDriver} lets the
 *       whole flow run headlessly for testing.</li>
 * </ul>
 *
 * <p>"Lost in Translation" triggers ONLY on genuine failures (render exception,
 * malformed message), never on user impatience, so it keeps its meaning as a
 * character beat rather than an annoyance.</p>
 *
 * <p><strong>Run:</strong> {@code javac DeliveryAdapter.java && java DeliveryAdapter}</p>
 */
public final class DeliveryAdapter {

    // =====================================================================
    // CoachMessage — minimal contract shared with Module 3b(1).
    // (In the real build this is imported from org.openchess.rookie.message;
    //  duplicated here so this file stands alone.)
    // =====================================================================

    public enum MessageType {
        BLUNDER("Blunder"), INACCURACY("Inaccuracy"), BRILLIANT("Brilliant move"),
        THEORY_NOTE("Theory note"), TACTIC_MISSED("Missed tactic"),
        SUMMARY("Game summary"), ENCOURAGEMENT("Encouragement");
        private final String label;
        MessageType(String l) { this.label = l; }
        public String label() { return label; }
    }

    public enum MessagePriority {
        LOW(0), MEDIUM(1), HIGH(2);
        private final int rank;
        MessagePriority(int r) { this.rank = r; }
        public int rank() { return rank; }
    }

    /** Immutable unit handed to the delivery layer. Carries a stable id. */
    public static final class CoachMessage {
        public static final int GLOBAL_MOVE_INDEX = -1;

        private final int id;
        private final int moveIndex;
        private final MessageType type;
        private final MessagePriority priority;
        private final String rawText;
        private final List<String> keySquares;

        CoachMessage(int id, int moveIndex, MessageType type,
                     MessagePriority priority, String rawText, List<String> keySquares) {
            this.id = id;
            this.moveIndex = moveIndex;
            this.type = type;
            this.priority = priority != null ? priority : defaultPriority(type);
            this.rawText = rawText == null ? "" : rawText;
            this.keySquares = keySquares == null ? List.of() : List.copyOf(keySquares);
        }

        public static MessagePriority defaultPriority(MessageType t) {
            switch (t) {
                case BLUNDER: case SUMMARY: return MessagePriority.HIGH;
                case BRILLIANT: case INACCURACY: case TACTIC_MISSED: return MessagePriority.MEDIUM;
                default: return MessagePriority.LOW;
            }
        }

        public int id() { return id; }
        public int moveIndex() { return moveIndex; }
        public MessageType type() { return type; }
        public MessagePriority priority() { return priority; }
        public String rawText() { return rawText; }
        public List<String> keySquares() { return keySquares; }
        public boolean isGlobal() { return moveIndex == GLOBAL_MOVE_INDEX; }

        @Override public String toString() {
            String where = isGlobal() ? "global" : ("move " + moveIndex);
            return "#" + id + " [" + type + "/" + priority + "@" + where + "] " + rawText;
        }
    }

    // =====================================================================
    // Config — tunables
    // =====================================================================

    public static final class DeliveryConfig {
        private final long tapTimeoutMs;
        private final long transitionMs;
        private final long fadeMs;
        private final long rechimeCooldownMs;
        private final int maxRechimes;
        private final Map<MessagePriority, List<String>> chimeByPriority;

        private DeliveryConfig(Builder b) {
            this.tapTimeoutMs = b.tapTimeoutMs;
            this.transitionMs = b.transitionMs;
            this.fadeMs = b.fadeMs;
            this.rechimeCooldownMs = b.rechimeCooldownMs;
            this.maxRechimes = b.maxRechimes;
            this.chimeByPriority = Map.copyOf(b.chimeByPriority);
        }

        public long tapTimeoutMs() { return tapTimeoutMs; }
        public long transitionMs() { return transitionMs; }
        public long fadeMs() { return fadeMs; }
        public long rechimeCooldownMs() { return rechimeCooldownMs; }
        public int maxRechimes() { return maxRechimes; }
        public List<String> chimePattern(MessagePriority p) { return chimeByPriority.getOrDefault(p, List.of("ping")); }

        public static DeliveryConfig defaults() { return new Builder().build(); }
        public static Builder builder() { return new Builder(); }

        public static final class Builder {
            private long tapTimeoutMs = 8000;
            private long transitionMs = 600;
            private long fadeMs = 400;
            private long rechimeCooldownMs = 15000;
            private int maxRechimes = 2;
            private Map<MessagePriority, List<String>> chimeByPriority = new LinkedHashMap<>();

            public Builder tapTimeoutMs(long v) { this.tapTimeoutMs = v; return this; }
            public Builder transitionMs(long v) { this.transitionMs = v; return this; }
            public Builder fadeMs(long v) { this.fadeMs = v; return this; }
            public Builder rechimeCooldownMs(long v) { this.rechimeCooldownMs = v; return this; }
            public Builder maxRechimes(int v) { this.maxRechimes = v; return this; }
            public Builder chimeFor(MessagePriority p, List<String> pattern) {
                this.chimeByPriority.put(p, pattern); return this;
            }
            public DeliveryConfig build() {
                if (chimeByPriority.isEmpty()) {
                    chimeByPriority.put(MessagePriority.HIGH, List.of("ping", "ping"));
                    chimeByPriority.put(MessagePriority.MEDIUM, List.of("ping"));
                    chimeByPriority.put(MessagePriority.LOW, List.of("tick"));
                }
                return new DeliveryConfig(this);
            }
        }
    }

    // =====================================================================
    // Engagement log — feeds PreferenceTracker (Module 3b(2))
