    /** Records how the user engaged with each delivered message. */
    public static final class EngagementLog {
        private final Map<Integer, Long> revealedAt = new LinkedHashMap<>();
        private final Map<Integer, Long> dwellTime = new LinkedHashMap<>();
        private final List<Integer> skippedIds = new ArrayList<>();
        private final List<Integer> erroredIds = new ArrayList<>();
        private final AtomicInteger totalChimes = new AtomicInteger();
        private final AtomicInteger ignoredChimes = new AtomicInteger();

        public void recordChime() { totalChimes.incrementAndGet(); }
        public void recordIgnoredChime() { ignoredChimes.incrementAndGet(); }
        public void recordRevealed(int messageId) { revealedAt.put(messageId, System.nanoTime()); }
        public void recordDwell(int messageId, long nanos) { dwellTime.put(messageId, nanos); }
        public void recordSkipped(int messageId) { skippedIds.add(messageId); }
        public void recordError(int messageId) { erroredIds.add(messageId); }

        public int totalChimes() { return totalChimes.get(); }
        public int ignoredChimes() { return ignoredChimes.get(); }
        public List<Integer> skippedIds() { return List.copyOf(skippedIds); }
        public List<Integer> erroredIds() { return List.copyOf(erroredIds); }
        public long dwellNanos(int messageId) { return dwellTime.getOrDefault(messageId, 0L); }

        /** Fraction of chimes the user actually tapped. Higher = more engaged. */
        public double tapRate() {
            int t = totalChimes.get();
            return t == 0 ? 1.0 : (double)(t - ignoredChimes.get()) / t;
        }
    }

