    /** Logs every presentation event so the demo can print the full flow. */
    public static final class SimulatedDriver implements PresentationDriver {
        private final List<String> log = new ArrayList<>();
        private final StateMachine sm;

        public SimulatedDriver(StateMachine sm) { this.sm = sm; }

        private void add(String s) { log.add(s); System.out.println("   | " + s); }

        @Override public void playChime(List<String> p) { add("🔔 chime: " + String.join("+", p)); }
        @Override public void showTapHint() { add("✨ tap hint shown on Rookie"); }
        @Override public void startTransition() { add("⏳ \"activating translator…\""); }
        @Override public void renderMessage(CoachMessage m) {
            add("💬 revealed: " + m.rawText());
            if (!m.keySquares().isEmpty()) add("   ⌗ highlight: " + String.join(", ", m.keySquares()));
        }
        @Override public void fadeOut() { add("↘ fading out"); }
        @Override public void showError() { add("❓ \"Lost in Translation\""); }
        @Override public void sendSessionEnd() { add("■ SESSION END"); }

        @Override public void onTapRookie() { add("👆 user tapped Rookie"); sm.onTapRookie(); }
        @Override public void onDismiss() { add("✕ user dismissed"); sm.onDismiss(); }
        @Override public void onRetry() { add("⟳ user retried"); sm.onRetry(); }
        @Override public void onSkip() { add("⤼ user skipped"); sm.onSkip(); }

        public List<String> log() { return log; }
    }

    // =====================================================================
    // Simulated TimerService — runs scheduled actions synchronously in order
    // =====================================================================

    /** Executes timers deterministically for headless testing. */
    public static final class SimulatedTimers implements TimerService {
        public static final class Handle implements TimerHandle {
            private final Runnable action; private boolean cancelled;
            Handle(Runnable a) { this.action = a; }
            @Override public void cancel() { cancelled = true; }
            void fire() { if (!cancelled) action.run(); }
        }
        private final List<Handle> pending = new ArrayList<>();

        @Override public TimerHandle schedule(long delayMs, Runnable action) {
            Handle h = new Handle(action);
            pending.add(h);
            return h;
        }
        /** Fire all currently-pending timers (used by the demo harness). */
        public void flushAll() {
            while (!pending.isEmpty()) {
                Handle h = pending.remove(0);
                h.fire();
            }
        }
    }

