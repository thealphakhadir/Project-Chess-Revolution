/**
 * Module 3: Vanguard — Player Safety &amp; Reporting System.
 *
 * <p>Numbering note: current project notes have this as Module 3, with
 * Sagacious (the analysis engine, previously Module 3) renumbered to a
 * new slot TBD. Flag if that should be the other way around.
 *
 * <p>This is a straight translation of the pseudocode design doc into
 * Java. It is organized in the same ten parts, in order, so it's easy
 * to diff against the spec. Every safety gate from Part 0 is enforced
 * by the actual control flow below, not just left as a comment:
 * <ol>
 *   <li>No code path runs from {@link #runAutomatedTriage} straight to
 *       {@link #applyPenalty}. Every penalty flows through
 *       {@link #reviewCase}, which requires a human {@code ModeratorDecision}.</li>
 *   <li>{@link #startCasePipeline} checks
 *       {@code deps.externalMinorSafetyDetectionFlagged(evidence)} and
 *       returns via {@link #routeToMinorSafetyPath} BEFORE
 *       {@link #runAutomatedTriage} is ever called — Claude never sees
 *       a minor-safety case.</li>
 *   <li>The only fully-automated action is
 *       {@code autoMuteUserPendingReview}, which is reversible and
 *       non-punitive. Strikes and bans always require
 *       {@link #reviewCase}.</li>
 *   <li>Every {@link Classification} carries {@link #RECOMMENDATION_LABEL}
 *       and is never itself sufficient to call {@link #applyPenalty}.</li>
 *   <li>Active-search tools (Part 10) are an exhaustive, closed list —
 *       see {@link TriageTools#ALL} — and the one tool with any
 *       web-search reach ({@code search_chess_domain_reference}) is
 *       rejected in code (not just by prompt) if the query references
 *       the reported player. See {@link #executeTool}.</li>
 * </ol>
 *
 * <p>Infrastructure and external-system calls (DB access, the real
 * Claude HTTP call, JSON parsing, etc.) are left as an injected
 * {@link VanguardDependencies} implementation — same approach used for
 * Sagacious's search-internals stubs. This file contains only
 * orchestration and policy logic: the enforcement ladder, the
 * human-gate flow, the minor-safety short-circuit, and the
 * active-search tool boundary.
 */
public final class Vanguard {

    private Vanguard() {
    }

    // ================================================================
    // Constants
    // ================================================================

    public static final String RECOMMENDATION_LABEL = "AI_SUGGESTED — PENDING HUMAN CONFIRMATION";
    public static final int MAX_TRIAGE_TOOL_CALLS = 6;
    /** Verify against docs.claude.com / the product-self-knowledge skill before deploying — model ids move. */
    public static final String CLAUDE_MODEL = "claude-sonnet-5";
    public static final int CLEAN_PERIOD_FOR_STRIKE_RESET_MONTHS = 9; // within the stated 6-12 month range
    public static final int GAME_HISTORY_WINDOW = 50;
    public static final int CHAT_HISTORY_WINDOW_DAYS = 90;

    // ================================================================
    // PART 1: DATA MODEL
    // ================================================================

    public enum OffenseCategory {
        GENERAL_ABUSE,
        HATE_SPEECH,
        SEXUAL_HARASSMENT,
        MINOR_SAFETY_CONCERN, // routed via Part 3, never reaches determinePenalty()
        SEVERE_THREAT_OR_DOXXING,
        BAN_EVASION_OR_MULTIACCOUNT
    }

    public enum CaseStatus {
        PENDING_AUTOMATED_TRIAGE,
        PENDING_HUMAN_REVIEW,
        CONFIRMED,
        DISMISSED,
        ESCALATED_TO_SAFETY_TEAM
    }

    public enum PenaltyType {
        NONE, WARNING, FINAL_WARNING, TEMP_BAN_3_MONTH, LIFETIME_BAN, ACCOUNT_SUSPENDED_PENDING_REVIEW
    }

    public static final Set<OffenseCategory> ZERO_TOLERANCE_CATEGORIES = Set.of(
            OffenseCategory.HATE_SPEECH,
            OffenseCategory.SEXUAL_HARASSMENT,
            OffenseCategory.SEVERE_THREAT_OR_DOXXING
    );

    public record Report(
            String reportId,
            String reporterId,
            String reportedUserId,
            OffenseCategory reporterAssertedCategory,
            String gameIdOrThreadId,
            Instant timestamp,
            String description
    ) {}

    /** Raised by automated tooling (slur filter, abuse-pattern detector, spam-rate trigger). */
    public record AutomatedFlag(String userId, String severity, String contextId) {}

    public record ReportedIncident(String transcript, String moveTimeline, List<Instant> timestamps) {}

    public record BehavioralSignals(
            List<String> moveTimingAnomalies,
            List<String> deviceFingerprints,
            List<String> linkedAccountHints
    ) {}

    public record FullAccountSnapshot(
            List<Object> recentGames,
            List<Object> chatHistory,
            List<Object> clubPosts,
            List<Object> forumActivity,
            Object profileContent,
            List<Object> friendRequests,
            List<Report> priorReports,
            List<PenaltyRecord> priorPenalties,
            BehavioralSignals behavioralSignals
    ) {}

    public record EvidenceBundle(
            String targetUserId,
            ReportedIncident reportedIncident,
            FullAccountSnapshot fullAccountSnapshot
    ) {}

    /** One entry per tool call Vanguard's Claude integration makes during triage — shown to the human reviewer. */
    public record ToolCallLogEntry(
            String toolName,
            Map<String, Object> toolInput,
            String resultSummary,
            Instant timestamp,
            boolean wasRejected,
            String rejectReason
    ) {}

    public record ConfirmedBy(String humanModeratorId, Classification aiAssistRecommendation) {}

    public record PenaltyRecord(
            String userId,
            OffenseCategory category,
            PenaltyType penaltyType,
            Instant issuedAt,
            Instant expiresAt, // null if not time-bound
            ConfirmedBy confirmedBy
    ) {}

    public static final class UserStandingRecord {
        public final String userId;
        public int generalAbuseStrikeCount;
        public Instant lastCleanPeriodStart;
        public int strikeResetCount; // tracked so escalateBeyondBaseLadder knows this isn't a first-timer
        public final List<PenaltyRecord> activePenalties = new ArrayList<>();
        public boolean lifetimeBanned;

        public UserStandingRecord(String userId) {
            this.userId = userId;
            this.lastCleanPeriodStart = Instant.now();
        }
    }

    /** Triage output. {@code suggestedCategory == null} means "no violation suggested" (the spec's NONE). */
    public record Classification(
            OffenseCategory suggestedCategory,
            double confidence,
            String suggestedPriority,
            String evidenceSummary,
            List<String> flaggedExcerpts,
            List<ToolCallLogEntry> searchesPerformed,
            String recommendationLabel
    ) {}

    public static final class Case {
        public final String caseId;
        public final String targetUserId;
        public final EvidenceBundle evidence;
        public Classification classification; // null for minor-safety-escalated cases
        public CaseStatus status;
        public OffenseCategory confirmedCategory; // set once a human CONFIRMED decision is made (Part 4)

        public Case(String caseId, String targetUserId, EvidenceBundle evidence,
                     Classification classification, CaseStatus status) {
            this.caseId = caseId;
            this.targetUserId = targetUserId;
            this.evidence = evidence;
            this.classification = classification;
            this.status = status;
        }
    }

    /** {@code outcome} is "CONFIRMED" or "DISMISSED"; {@code confirmedCategory} is set only when CONFIRMED. */
    public record ModeratorDecision(String outcome, OffenseCategory confirmedCategory) {}

    /** {@code type} e.g. "PROCESS_OR_FACTUAL_ERROR" — the only type zero-tolerance categories accept. */
    public record AppealReason(String type, String detail) {}

    public static final class AppealCase {
        public final String appealCaseId;
        public final String userId;
        public final String originalCaseId;
        public final AppealReason reason;

        public AppealCase(String appealCaseId, String userId, String originalCaseId, AppealReason reason) {
            this.appealCaseId = appealCaseId;
            this.userId = userId;
            this.originalCaseId = originalCaseId;
            this.reason = reason;
        }
    }

    /** {@code outcome} is "OVERTURNED" or "UPHELD". */
    public record AppealDecision(String outcome) {}

    // ================================================================
    // Claude integration types (Part 8 / Part 10)
    // ================================================================

    public enum OutputFormat { JSON_ONLY, TEXT, JSON_OR_TOOL_CALL, TEXT_OR_TOOL_CALL }

    public record ClaudeMessage(String role, String content) {}

    public record ToolDefinition(String name, String description, Map<String, String> inputSchema) {}

    public enum ClaudeResponseType { FINAL_JSON, FINAL_TEXT, TOOL_USE }

    public record ClaudeResponse(
            ClaudeResponseType type,
            String content,                  // populated for FINAL_JSON / FINAL_TEXT
            String toolName,                  // populated for TOOL_USE
            Map<String, Object> toolInput,    // populated for TOOL_USE
