    /**
     * Factual notice of an ALREADY human-confirmed outcome — no search
     * tools here. There's nothing left to investigate; giving this step
     * active search would only invite the model to re-litigate a
     * decision that isn't its call to revisit.
     */
    public static String buildUserFacingExplanation(String userId, OffenseCategory category, PenaltyType penalty, VanguardDependencies deps) {
        String prompt = """
                Write a brief, clear, and firm (not harsh) notification to a user
                explaining that their account received a %s for a confirmed
                violation of the platform's %s policy. State the current strike
                level if applicable. Do not argue the case or add unnecessary
                detail — this is a factual notice, already confirmed by a human
                moderator.
                """.formatted(penalty, category);

        ClaudeResponse response = deps.callClaude(
                "You draft short, neutral, factual moderation notices. You do not soften or negotiate policy.",
                List.of(new ClaudeMessage("user", prompt)),
                null,
                OutputFormat.TEXT
        );
        return response.content();
    }

    /**
     * User-facing support surface. Gets exactly ONE scoped tool — policy
     * lookup — so it can answer "what does this rule mean" or "how does
     * an appeal work" accurately. It only ever sees this user's own
     * case record, never other users' data, and never re-litigates the
     * verdict itself. (A production version would loop on TOOL_USE the
     * same way {@link #runAutomatedTriage} does; omitted here since
     * it's the identical pattern against a one-tool set.)
     */
    public static String answerUserCaseQuestion(String userId, String question, VanguardDependencies deps) {
        Object caseRecord = deps.getConfirmedCaseRecordFor(userId);

        String system = "You answer a user's questions about their own moderation case using only "
                + "the provided case record and, if needed, the policy_knowledge_base tool. You "
                + "explain what happened and what the appeal process covers. You do not overturn, "
                + "second-guess, or promise to overturn the decision — appeals go through the human "
                + "process (see submitAppeal).";

        String userContent = "Case record: " + caseRecord + "\n\nUser question: " + question;

        ClaudeResponse response = deps.callClaude(
                system,
                List.of(new ClaudeMessage("user", userContent)),
                List.of(TriageTools.POLICY_KNOWLEDGE_BASE), // subset of Part 10 — no user-history/precedent tools
                OutputFormat.TEXT_OR_TOOL_CALL
        );
        return response.content();
    }

