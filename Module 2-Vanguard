        Case createCase(String targetUserId, EvidenceBundle evidence, Classification classification, CaseStatus status);
        Case getCase(String caseId);
        void closeCase(String caseId, CaseStatus finalStatus);
        void enqueueForHumanReview(Case c, String priority);
        void enqueueAppealForHumanReview(AppealCase appealCase, String priority, boolean reviewerMustDifferFromOriginal);
