    public static AppealCase submitAppeal(String userId, String caseId, AppealReason appealReason, VanguardDependencies deps) {
        Case c = deps.getConfirmedCase(caseId);

        if (ZERO_TOLERANCE_CATEGORIES.contains(c.confirmedCategory)) {
            // Appeals only for process/factual errors, never "I didn't
            // mean it," even here.
            if (!"PROCESS_OR_FACTUAL_ERROR".equals(appealReason.type())) {
                deps.rejectAppeal("Zero-tolerance categories only accept process/factual-error appeals");
                return null;
            }
        }

        AppealCase appealCase = deps.createAppealCase(userId, caseId, appealReason);
        deps.enqueueAppealForHumanReview(appealCase, "APPEAL", true); // reviewerMustDifferFromOriginal
        return appealCase;
    }

    public static void resolveAppeal(String appealCaseId, String reviewerId, AppealDecision decision, VanguardDependencies deps) {
        if ("OVERTURNED".equals(decision.outcome())) {
            deps.reversePenalty(appealCaseId);
            deps.restoreStrikeIfApplicable(appealCaseId);
        }
        deps.logModerationDecision(appealCaseId, reviewerId, decision);
        deps.notifyUserOfAppealOutcome(appealCaseId, decision);
    }

