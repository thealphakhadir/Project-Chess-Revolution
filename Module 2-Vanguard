    public record ToolResult(Object content, ToolCallLogEntry logEntry) {}

    // ================================================================
    // External dependencies
    // ----------------------------------------------------------------
    // Same approach as Sagacious's search-internals stubs: infrastructure
    // and external-system integration points are an injected interface,
    // not guessed at here. None of these are policy/judgment logic —
    // that logic (the enforcement ladder, the human-gate flow, the
    // minor-safety short-circuit, the active-search tool boundary)
    // lives in this file. Implement one concrete class per environment
    // and pass it into every entry point below.
    // ================================================================

