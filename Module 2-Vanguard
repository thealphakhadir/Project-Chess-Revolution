    // ================================================================
    // PART 2: INTAKE & TRIAGE
    // ================================================================

    public static Case onReportSubmitted(Report report, VanguardDependencies deps) {
        return startCasePipeline("USER_REPORT", report, null, deps);
    }

    public static Case onAutomatedFlagRaised(AutomatedFlag flag, VanguardDependencies deps) {
        return startCasePipeline("AUTOMATED_FLAG", null, flag, deps);
    }

    public static Case startCasePipeline(String triggerType, Report report, AutomatedFlag flag, VanguardDependencies deps) {
        String targetUserId = (report != null) ? report.reportedUserId() : flag.userId();

        // Immediate, non-punitive, reversible safety action — allowed
        // fully automated because it's not a strike/ban (Part 0.3).
        if ("AUTOMATED_FLAG".equals(triggerType) && flag != null && "HIGH_CONFIDENCE_SLUR".equals(flag.severity())) {
            deps.autoMuteUserPendingReview(targetUserId, flag.contextId());
        }

        EvidenceBundle evidence = assembleEvidenceBundle(targetUserId, report, flag, deps);

        // Minor-safety signals short-circuit everything else — Part 3.
        // This check runs BEFORE Claude's active-search triage loop ever
        // sees the evidence.
        if (deps.externalMinorSafetyDetectionFlagged(evidence)) {
            return routeToMinorSafetyPath(targetUserId, evidence, deps);
        }

        Classification classification = runAutomatedTriage(evidence, deps);

        Case c = deps.createCase(targetUserId, evidence, classification, CaseStatus.PENDING_HUMAN_REVIEW);
        deps.enqueueForHumanReview(c, classification.suggestedPriority());
        return c;
    }

    public static EvidenceBundle assembleEvidenceBundle(String userId, Report report, AutomatedFlag flag, VanguardDependencies deps) {
        // Full-account pull — not just the reported incident. This is
        // the base snapshot; Part 8's search loop queries further
        // WITHIN this (and a few reference sources), it does not fetch
        // new categories of data about the user.
        ReportedIncident incident = deps.extractIncidentContext(report, flag);
        FullAccountSnapshot snapshot = new FullAccountSnapshot(
                deps.fetchRecentGames(userId, GAME_HISTORY_WINDOW),
                deps.fetchChatHistory(userId, CHAT_HISTORY_WINDOW_DAYS),
                deps.fetchClubActivity(userId),
                deps.fetchForumActivity(userId),
                deps.fetchProfileContent(userId),
                deps.fetchFriendRequestActivity(userId),
                deps.fetchPriorReports(userId),
                deps.fetchPriorPenalties(userId),
                deps.computeBehavioralSignals(userId)
        );
        return new EvidenceBundle(userId, incident, snapshot);
    }

    // ================================================================
    // PART 3: MINOR-SAFETY PATH (separate, never AI-adjudicated)
    // ================================================================

    public static Case routeToMinorSafetyPath(String userId, EvidenceBundle evidence, VanguardDependencies deps) {
        deps.suspendAccountImmediately(userId, "PENDING_SAFETY_REVIEW");
        deps.preserveEvidenceImmutably(evidence); // legal hold — no auto-deletion, no user edit access

        Case c = deps.createCase(userId, evidence, null, CaseStatus.ESCALATED_TO_SAFETY_TEAM);

        deps.notifyDedicatedSafetyTeam(c.caseId, "IMMEDIATE");
        deps.initiateLegalReferralWorkflow(c.caseId); // e.g. NCMEC CyberTipline or local equivalent

        // No AI classification, no active-search tools, no standard
        // strike ladder, no self-serve appeal path — this case exists
        // entirely outside Parts 4-9. runAutomatedTriage() is never
        // called on this path, full stop.
        return c;
    }

    // ================================================================
    // PART 4: HUMAN REVIEW GATE
    // ================================================================

    public static void reviewCase(String caseId, String moderatorId, ModeratorDecision decision, VanguardDependencies deps) {
        Case c = deps.getCase(caseId);

        if ("DISMISSED".equals(decision.outcome())) {
            deps.closeCase(caseId, CaseStatus.DISMISSED);
            // NOTE: matches the original pseudocode exactly, which
            // returns here — before logModerationDecision below — so
            // dismissals currently skip the audit-trail call. Flagging
            // in case that asymmetry isn't intentional; one-line fix
            // (drop this return) if you want dismissals logged too.
            return;
        }

        if ("CONFIRMED".equals(decision.outcome())) {
            c.confirmedCategory = decision.confirmedCategory();
            PenaltyType penalty = determinePenalty(c.targetUserId, decision.confirmedCategory(), deps);
            applyPenalty(c.targetUserId, decision.confirmedCategory(), penalty, moderatorId, c.classification, deps);
            deps.closeCase(caseId, CaseStatus.CONFIRMED);
            notifyUserOfOutcome(c.targetUserId, decision.confirmedCategory, penalty, deps);
}

        deps.logModerationDecision(caseId, moderatorId, decision); // full audit trail, always
    }

    // ================================================================
    // PART 5: PENALTY DETERMINATION — THE ENFORCEMENT LADDER
    // ================================================================

    public static PenaltyType determinePenalty(String userId, OffenseCategory confirmedCategory, VanguardDependencies deps) {
        UserStandingRecord standing = deps.getUserStandingRecord(userId);

        if (ZERO_TOLERANCE_CATEGORIES.contains(confirmedCategory)) {
            return PenaltyType.LIFETIME_BAN;
        }

        if (confirmedCategory == OffenseCategory.BAN_EVASION_OR_MULTIACCOUNT) {
            PenaltyType linkedPenalty = deps.getHighestPenaltyAmongLinkedAccounts(userId);
            return maxSeverity(linkedPenalty, PenaltyType.TEMP_BAN_3_MONTH);
        }

        if (confirmedCategory == OffenseCategory.GENERAL_ABUSE) {
            return applyProgressiveDiscipline(standing);
        }

        return PenaltyType.NONE;
    }

    private static PenaltyType applyProgressiveDiscipline(UserStandingRecord standing) {
        maybeResetStrikes(standing);
        int strikeCount = standing.generalAbuseStrikeCount + 1;

        switch (strikeCount) {
            case 1: return PenaltyType.WARNING;
            case 2: return PenaltyType.FINAL_WARNING;
            case 3: return PenaltyType.TEMP_BAN_3_MONTH;
            default:
                // Returned after a ban and re-offended — escalate beyond
                // the base ladder rather than looping back to a 3-month ban.
                return escalateBeyondBaseLadder(standing);
        }
    }

    private static void maybeResetStrikes(UserStandingRecord standing) {
        boolean cleanPeriodElapsed = monthsBetween(standing.lastCleanPeriodStart, Instant.now())
                >= CLEAN_PERIOD_FOR_STRIKE_RESET_MONTHS;
        boolean hadPriorBan = standing.activePenalties.stream()
                .anyMatch(p -> p.penaltyType() == PenaltyType.TEMP_BAN_3_MONTH);

        if (cleanPeriodElapsed && hadPriorBan) {
            standing.generalAbuseStrikeCount = 0;
            standing.strikeResetCount += 1;
        }
    }

    private static PenaltyType escalateBeyondBaseLadder(UserStandingRecord standing) {
        // Repeat offender after returning from a ban — escalated
        // penalties, not just repeating 3-month bans forever.
        if (standing.strikeResetCount >= 1) {
            return PenaltyType.LIFETIME_BAN; // second time through the ladder after a return
        }
        return PenaltyType.TEMP_BAN_3_MONTH;
    }

    private static final List<PenaltyType> SEVERITY_ORDER = List.of(
            PenaltyType.NONE, PenaltyType.WARNING, PenaltyType.FINAL_WARNING,
            PenaltyType.TEMP_BAN_3_MONTH, PenaltyType.ACCOUNT_SUSPENDED_PENDING_REVIEW,
            PenaltyType.LIFETIME_BAN
    );

    private static PenaltyType maxSeverity(PenaltyType a, PenaltyType b) {
        if (a == null) return b;
        if (b == null) return a;
        return SEVERITY_ORDER.indexOf(a) >= SEVERITY_ORDER.indexOf(b) ? a : b;
    }

    /** Instant has no calendar MONTHS unit, so route through LocalDate for a real calendar-month comparison. */
    private static long monthsBetween(Instant from, Instant to) {
        LocalDate fromDate = from.atZone(ZoneOffset.UTC).toLocalDate();
        LocalDate toDate = to.atZone(ZoneOffset.UTC).toLocalDate();
        return ChronoUnit.MONTHS.between(fromDate, toDate);
    }

    private static Instant plusMonths(Instant from, int months) {
        return from.atZone(ZoneOffset.UTC).plusMonths(months).toInstant();
    }

    // ================================================================
    // PART 6: PENALTY APPLICATION & NOTIFICATION
    // ================================================================

    public static void applyPenalty(String userId, OffenseCategory category, PenaltyType penalty,
                                     String confirmedByModeratorId, Classification aiRecommendation,
                                     VanguardDependencies deps) {
        Instant issuedAt = Instant.now();
        Instant expiresAt = (penalty == PenaltyType.TEMP_BAN_3_MONTH) ? plusMonths(issuedAt, 3) : null;

        PenaltyRecord record = new PenaltyRecord(
                userId, category, penalty, issuedAt, expiresAt,
                new ConfirmedBy(confirmedByModeratorId, aiRecommendation)
        );

        deps.persistPenaltyRecord(record);
        deps.updateUserStandingRecord(userId, record);

        switch (penalty) {
            case WARNING:
            case FINAL_WARNING:
                recordStrike(userId, deps);
                break;
            case TEMP_BAN_3_MONTH:
                recordStrike(userId, deps);
                deps.suspendAccountForDuration(userId, Duration.between(issuedAt, expiresAt));
                break;
            case LIFETIME_BAN:
                deps.terminateAccountPermanently(userId);
                deps.applyDeviceAndIPBanIfWarranted(userId, category);
                if (deps.categoryRequiresLegalReferral(category)) {
                    deps.initiateLegalReferralWorkflow(userId); // e.g. credible threats
                }
                break;
            default:
                break;
        }

        checkLinkedAccountsForMirroredPenalty(userId, record, deps); // ban-evasion detection, Part 7
    }

    public static void notifyUserOfOutcome(String userId, OffenseCategory category, PenaltyType penalty, VanguardDependencies deps) {
        String message = buildUserFacingExplanation(userId, category, penalty, deps); // Claude-assisted, Part 8
        deps.sendNotification(userId, message, true);
    }

    private static void recordStrike(String userId, VanguardDependencies deps) {
        UserStandingRecord standing = deps.getUserStandingRecord(userId);
        standing.generalAbuseStrikeCount += 1;
        standing.lastCleanPeriodStart = Instant.now();
    }

    // ================================================================
    // PART 7: BAN EVASION / LINKED ACCOUNTS
    // ================================================================

    public static void checkLinkedAccountsForMirroredPenalty(String userId, PenaltyRecord record, VanguardDependencies deps) {
        List<String> linkedAccounts = deps.detectLinkedAccounts(userId); // device fingerprint, IP overlap, behavioral similarity

        for (String linkedId : linkedAccounts) {
            if (!deps.hasEquivalentOrGreaterPenalty(linkedId, record.penaltyType())) {
                deps.flagForExpeditedReview(linkedId, "LINKED_TO_PENALIZED_ACCOUNT", record);
                // Still goes through the human review gate (Part 4) —
                // linkage is strong evidence, not an automatic verdict.
            }
        }
    }

    // ================================================================
    // PART 8: CLAUDE INTEGRATION — VANGUARD'S ACTIVE-SEARCH TRIAGE
    // ----------------------------------------------------------------
    // Claude's role, end to end, is unchanged in KIND from the original
    // spec: (1) triage/evidence summarization feeding the human
    // reviewer, (2) drafting the user-facing explanation of an
    // already-human-confirmed outcome, (3) answering user questions
    // about their own case. What's new is that (1) is agentic: instead
    // of one fixed prompt, Claude runs a bounded loop where it can call
    // read-only search tools (Part 10) before finalizing a
    // recommendation. Claude still never sets case status, never calls
    // applyPenalty, and every output is labeled AI-generated and
    // advisory.
    // ================================================================

    public static final String TRIAGE_SYSTEM_PROMPT = """
            You are Vanguard, a moderation triage assistant for a chess platform.
            You summarize evidence and suggest a category and priority for human
            moderators — you do NOT make final moderation decisions. You have
            tools to actively search for more context; use them when the initial
            incident is ambiguous, but every tool is scoped to this platform's
            own records or non-personal reference material. You have no tool
            that looks up a person's real-world identity, and you must never ask
            a human to run that kind of lookup either.

            Never suggest a lifetime ban or any irreversible action as a
            foregone conclusion; frame everything as input to a human reviewer.
            If the evidence is ambiguous even after searching, say so explicitly
            rather than forcing a confident classification. If anything in the
            evidence suggests a minor may be involved in a sexual-content
            context, stop immediately — do not call any more tools, do not
            attempt to classify or summarize that content further — and output
            ESCALATE_MINOR_SAFETY instead of a normal category.
            """;

    public static Classification runAutomatedTriage(EvidenceBundle evidence, VanguardDependencies deps) {
        List<ClaudeMessage> conversation = new ArrayList<>();
        conversation.add(new ClaudeMessage("user", buildTriagePrompt(evidence)));

        List<ToolCallLogEntry> toolLog = new ArrayList<>();

        while (toolLog.size() < MAX_TRIAGE_TOOL_CALLS) {
            ClaudeResponse response = deps.callClaude(
                    TRIAGE_SYSTEM_PROMPT, conversation, TriageTools.ALL, OutputFormat.JSON_OR_TOOL_CALL
            );

            if (response.type() == ClaudeResponseType.TOOL_USE) {
                ToolResult result = executeTool(response.toolName(), response.toolInput(), evidence.targetUserId(), deps);
                toolLog.add(result.logEntry());
                conversation.add(response.toolCallMessage());
                conversation.add(new ClaudeMessage("tool_result", String.valueOf(result.content())));
                continue; // let Claude decide whether it needs another search or is ready to answer
            }

            // response.type() == FINAL_JSON
            return parseTriageJson(response.content(), toolLog);
        }

        // Ran out of tool-call budget without a final answer. Fail safe:
        // hand the human reviewer everything gathered so far as a
        // low-confidence recommendation, rather than looping or guessing.
        return buildLowConfidenceFallback(toolLog);
    }

    private static String buildTriagePrompt(EvidenceBundle evidence) {
        return """
                Reported incident:
                %s

                You have tools to pull more context if the reported incident alone
                isn't enough to classify confidently — use them before answering,
                not instead of answering. When you're done, respond with final
                JSON only.

                Classify the reported incident into one of: GENERAL_ABUSE,
