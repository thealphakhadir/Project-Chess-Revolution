        }
    }

    /** A tactical opportunity that existed but was not taken. */
    public record TacticFinding(int moveIndex, String motif, String description, List<String> keySquares) {
        public TacticFinding {
            keySquares = keySquares == null ? List.of() : List.copyOf(keySquares);
        }
    }

    /** A point where the user departed from recognised opening theory. */
    public record TheoryDeviation(int moveIndex, String ecoCode, String openingName, String deviationNote) {}

    /** Aggregated analytical findings for a single finished game. */
    public static final class AnalysisResult {
        private final EvalCurve evalCurve;
        private final List<TacticFinding> missedTactics;
        private final List<TheoryDeviation> theoryDeviations;
        private final List<int[]> brilliantMoments;

        private AnalysisResult(Builder b) {
            this.evalCurve = b.evalCurve != null ? b.evalCurve : EvalCurve.empty();
            this.missedTactics = Collections.unmodifiableList(new ArrayList<>(b.missedTactics));
            this.theoryDeviations = Collections.unmodifiableList(new ArrayList<>(b.theoryDeviations));
            this.brilliantMoments = Collections.unmodifiableList(new ArrayList<>(b.brilliantMoments));
        }

        public EvalCurve evalCurve() { return evalCurve; }
        public List<TacticFinding> missedTactics() { return missedTactics; }
        public List<TheoryDeviation> theoryDeviations() { return theoryDeviations; }
        public List<int[]> brilliantMoments() { return brilliantMoments; }

        public static Builder builder() { return new Builder(); }

        public static final class Builder {
            private EvalCurve evalCurve;
            private final List<TacticFinding> missedTactics = new ArrayList<>();
            private final List<TheoryDeviation> theoryDeviations = new ArrayList<>();
            private final List<int[]> brilliantMoments = new ArrayList<>();

            public Builder evalCurve(EvalCurve v) { this.evalCurve = v; return this; }
            public Builder addTactic(TacticFinding v) { this.missedTactics.add(v); return this; }
            public Builder addTheory(TheoryDeviation v) { this.theoryDeviations.add(v); return this; }
            public Builder addBrilliantMoment(int moveIndex) { this.brilliantMoments.add(new int[]{moveIndex}); return this; }
            public AnalysisResult build() { return new AnalysisResult(this); }
        }
    }

