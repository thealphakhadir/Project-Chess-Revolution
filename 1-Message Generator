/**
 * Module 3b(1) — Rookie Message Generator.
 *
 * <p>Self-contained build of the post-game coaching message generator for
 * OpenChess. Given a finished {@link GameRecord} and an {@link AnalysisResult},
 * it walks the evaluation curve and emits an ordered, capped list of
 * {@link CoachMessage}s ready for delivery to the UI.</p>
 *
 * <p><strong>Design notes</strong></p>
 * <ul>
 *   <li>Post-game only. No pre-move advice is ever produced.</li>
 *   <li>All text here is factual/analytical. Tone and persona adaptation is a
 *       downstream concern (future PersonaAdapter, Module 3b(2)).</li>
 *   <li>Evaluation scale is assumed to be pawns from White's perspective.
 *       Confirm this matches Sagacious output before relying on thresholds.</li>
 *   <li>Sagacious / Explorer / Codex integrations are stubbed behind small
 *       static helpers ({@link Stubs}) so the pipeline runs today on canned
 *       data with zero external dependencies.</li>
 * </ul>
 *
 * <p><strong>Run:</strong> {@code javac MessageGenerator.java && java MessageGenerator}</p>
 */
public final class MessageGenerator {

    // =====================================================================
    // Enums
    // =====================================================================

    /** Categorises what a {@link CoachMessage} is reacting to. */
    public enum MessageType {
        BLUNDER("Blunder"),
        INACCURACY("Inaccuracy"),
        BRILLIANT("Brilliant move"),
        THEORY_NOTE("Theory note"),
        TACTIC_MISSED("Missed tactic"),
        SUMMARY("Game summary"),
        ENCOURAGEMENT("Encouragement");

        private final String label;
        MessageType(String label) { this.label = label; }
        public String label() { return label; }
    }

    /** Relative importance used for ordering and cap survival. */
    public enum MessagePriority {
        LOW(0), MEDIUM(1), HIGH(2);

        private final int rank;
        MessagePriority(int rank) { this.rank = rank; }
        public int rank() { return rank; }
        public boolean atLeast(MessagePriority o) { return this.rank >= o.rank; }
    }

    // =====================================================================
    // Core value types
    // =====================================================================

    /** Immutable unit of coaching output. The contract for downstream consumers. */
    public static final class CoachMessage {
        public static final int GLOBAL_MOVE_INDEX = -1;

        private final int moveIndex;
        private final MessageType type;
        private final MessagePriority priority;
        private final String rawText;
        private final List<String> keySquares;
        private final List<Integer> relatedMoveIndexes;

        private CoachMessage(Builder b) {
            this.moveIndex = b.moveIndex;
            this.type = b.type;
            this.priority = b.priority != null ? b.priority : defaultPriority(b.type);
            this.rawText = b.rawText == null ? "" : b.rawText;
            this.keySquares = Collections.unmodifiableList(new ArrayList<>(b.keySquares));
            this.relatedMoveIndexes = Collections.unmodifiableList(new ArrayList<>(b.relatedMoveIndexes));
        }

        public static MessagePriority defaultPriority(MessageType type) {
            switch (type) {
                case BLUNDER: return MessagePriority.HIGH;
                case BRILLIANT: return MessagePriority.MEDIUM;
                case INACCURACY:
                case TACTIC_MISSED: return MessagePriority.MEDIUM;
                case THEORY_NOTE:
                case ENCOURAGEMENT: return MessagePriority.LOW;
                case SUMMARY: return MessagePriority.HIGH;
                default: return MessagePriority.LOW;
            }
        }

        public int moveIndex() { return moveIndex; }
        public MessageType type() { return type; }
        public MessagePriority priority() { return priority; }
        public String rawText() { return rawText; }
        public List<String> keySquares() { return keySquares; }
        public List<Integer> relatedMoveIndexes() { return relatedMoveIndexes; }
        public boolean isGlobal() { return moveIndex == GLOBAL_MOVE_INDEX; }

        @Override
        public String toString() {
            String where = isGlobal() ? "global" : ("move " + moveIndex);
            return "[" + type + "/" + priority + "@" + where + "] " + rawText;
        }

        public static Builder builder() { return new Builder(); }

        public static final class Builder {
            private int moveIndex = GLOBAL_MOVE_INDEX;
            private MessageType type;
            private MessagePriority priority;
            private String rawText;
            private final List<String> keySquares = new ArrayList<>();
            private final List<Integer> relatedMoveIndexes = new ArrayList<>();

            public Builder moveIndex(int v) { this.moveIndex = v; return this; }
            public Builder type(MessageType v) { this.type = v; return this; }
            public Builder priority(MessagePriority v) { this.priority = v; return this; }
            public Builder rawText(String v) { this.rawText = v; return this; }
            public Builder keySquares(List<String> v) { if (v != null) this.keySquares.addAll(v); return this; }
            public Builder keySquare(String s) { this.keySquares.add(s); return this; }
            public Builder relatedMoves(List<Integer> v) { if (v != null) this.relatedMoveIndexes.addAll(v); return this; }

            public CoachMessage build() {
                if (type == null) throw new IllegalStateException("type is required");
                return new CoachMessage(this);
            }
        }
    }

    /** A single sampled point on the evaluation curve (White's view, pawns). */
    public record EvalPoint(int moveIndex, double scoreWhite) {
        public EvalPoint {
            if (scoreWhite == Double.NaN) throw new IllegalArgumentException("evaluation must not be NaN");
        }
    }

    /** Ordered sequence of {@link EvalPoint}s covering a whole game. */
    public static final class EvalCurve {
        private final List<EvalPoint> points;

        public EvalCurve(List<EvalPoint> points) {
            this.points = points == null ? new ArrayList<>() : new ArrayList<>(points);
            this.points.sort(Comparator.comparingInt(EvalPoint::moveIndex));
        }

        public static EvalCurve empty() { return new EvalCurve(Collections.emptyList()); }
        public List<EvalPoint> points() { return Collections.unmodifiableList(points); }
        public int size() { return points.size(); }
        public boolean isEmpty() { return points.isEmpty(); }

        public EvalPoint at(int moveIndex) {
            for (EvalPoint p : points) if (p.moveIndex() == moveIndex) return p;
            return null;
        }

        public double peakForWhite() {
            double m = Double.NEGATIVE_INFINITY;
            for (EvalPoint p : points) m = Math.max(m, p.scoreWhite());
            return points.isEmpty() ? 0.0 : m;
        }

        public double troughForWhite() {
            double m = Double.POSITIVE_INFINITY;
            for (EvalPoint p : points) m = Math.min(m, p.scoreWhite());
            return points.isEmpty() ? 0.0 : m;
        }
    }

    /** Minimal representation of a finished game, sufficient for post-game analysis. */
    public static final class GameRecord {
        public enum Colour { WHITE, BLACK }

        private final String whiteName;
        private final String blackName;
        private final List<String> sanMoves;
        private final List<String> fenAfterEachMove;
        private final String result;
        private final Colour userColour;
        private final String timeControl;

        private GameRecord(Builder b) {
            this.whiteName = nz(b.whiteName);
            this.blackName = nz(b.blackName);
            this.sanMoves = Collections.unmodifiableList(new ArrayList<>(b.sanMoves));
            this.fenAfterEachMove = Collections.unmodifiableList(new ArrayList<>(b.fenAfterEachMove));
            this.result = nz(b.result);
            this.userColour = b.userColour != null ? b.userColour : Colour.WHITE;
            this.timeControl = nz(b.timeControl);
        }

        private static String nz(String s) { return s == null ? "" : s; }

        public String whiteName() { return whiteName; }
        public String blackName() { return blackName; }
        public List<String> sanMoves() { return sanMoves; }
        public List<String> fenAfterEachMove() { return fenAfterEachMove; }
        public String result() { return result; }
        public Colour userColour() { return userColour; }
        public String timeControl() { return timeControl; }
        public int plyCount() { return sanMoves.size(); }

        public static Builder builder() { return new Builder(); }

        public static final class Builder {
            private String whiteName;
            private String blackName;
            private final List<String> sanMoves = new ArrayList<>();
            private final List<String> fenAfterEachMove = new ArrayList<>();
            private String result;
            private Colour userColour;
