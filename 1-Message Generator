    private final GenerationConfig config;

    public MessageGenerator(GenerationConfig config) {
        this.config = config != null ? config : GenerationConfig.defaults();
    }

    public MessageGenerator() {
        this(GenerationConfig.defaults());
    }

    /** Run all passes and return the final ordered message list. */
    public List<CoachMessage> generate(GameRecord game, AnalysisResult analysis) {
        if (game == null || analysis == null) {
            throw new IllegalArgumentException("game and analysis must not be null");
        }

        List<CoachMessage> all = new ArrayList<>();
        all.addAll(passMistakes(game, analysis));
        all.addAll(passBrilliance(game, analysis));
        if (config.includeTheory()) all.addAll(passTheory(game, analysis));
        if (config.includeTactics()) all.addAll(passTactics(game, analysis));

        List<CoachMessage> batched = batchMistakes(all);
        List<CoachMessage> kept = applyCap(batched);
        List<CoachMessage> demoted = demotedFrom(batched, kept);

        CoachMessage summary = composeSummary(game, analysis, kept, demoted);
        List<CoachMessage> result = new ArrayList<>(kept);
        result.add(summary);

        result.sort(Comparator
                .comparingInt((CoachMessage m) -> m.isGlobal() ? Integer.MAX_VALUE : m.moveIndex())
                .thenComparing(m -> m.type().label()));
        return result;
    }

    private List<CoachMessage> passMistakes(GameRecord game, AnalysisResult analysis) {
        List<CoachMessage> out = new ArrayList<>();
        EvalCurve curve = analysis.evalCurve();
        if (curve.isEmpty()) return out;

        double sign = game.userColour() == GameRecord.Colour.WHITE ? 1.0 : -1.0;
        List<EvalPoint> pts = curve.points();

        for (int i = 1; i < pts.size(); i++) {
            EvalPoint prev = pts.get(i - 1);
            EvalPoint cur = pts.get(i);
            if (!isUserPly(game, cur.moveIndex())) continue;

            double beforeUser = sign * prev.scoreWhite();
            double afterUser = sign * cur.scoreWhite();
            double drop = beforeUser - afterUser;

            if (drop >= config.blunderThreshold()) {
                out.add(buildMistake(cur.moveIndex(), MessageType.BLUNDER, drop, game));
            } else if (drop >= config.inaccuracyThreshold()) {
                out.add(buildMistake(cur.moveIndex(), MessageType.INACCURACY, drop, game));
            }
        }
        return out;
    }

    private CoachMessage buildMistake(int moveIndex, MessageType type, double drop, GameRecord game) {
        String san = sanOfPly(game, moveIndex);
        String text;
        if (type == MessageType.BLUNDER) {
            text = String.format("%s (move %d) cost roughly %.1f pawns. Position swung sharply against you.",
                    san, moveIndex, drop);
        } else {
            text = String.format("%s (move %d) was slightly off; best play held about %.1f pawns more.",
                    san, moveIndex, drop);
        }
        return CoachMessage.builder()
                .moveIndex(moveIndex)
                .type(type)
                .priority(MessagePriority.defaultPriority(type))
                .rawText(text)
                .keySquare(squareFromFenHighlight())
                .build();
    }

    private List<CoachMessage> passBrilliance(GameRecord game, AnalysisResult analysis) {
        List<CoachMessage> out = new ArrayList<>();
        double sign = game.userColour() == GameRecord.Colour.WHITE ? 1.0 : -1.0;
        List<EvalPoint> pts = analysis.evalCurve().points();

        Map<Integer, Boolean> seen = new LinkedHashMap<>();
        for (int[] bm : analysis.brilliantMoments()) {
            int mi = bm[0];
            if (seen.put(mi, Boolean.TRUE) != null) continue;
            String san = sanOfPly(game, mi);
            out.add(CoachMessage.builder()
                    .moveIndex(mi)
                    .type(MessageType.BRILLIANT)
                    .priority(MessagePriority.MEDIUM)
                    .rawText(String.format("%s (move %d) was a strong choice — it improved your position notably.", san, mi))
                    .build());
        }

        for (int i = 1; i < pts.size(); i++) {
            int mi = pts.get(i).moveIndex();
            if (!isUserPly(game, mi) || seen.containsKey(mi)) continue;
            double rise = sign * (pts.get(i).scoreWhite() - pts.get(i - 1).scoreWhite());
            if (rise >= config.brillianceThreshold()) {
                seen.put(mi, Boolean.TRUE);
                String san = sanOfPly(game, mi);
                out.add(CoachMessage.builder()
                        .moveIndex(mi)
                        .type(MessageType.BRILLIANT)
                        .priority(MessagePriority.MEDIUM)
                        .rawText(String.format("%s (move %d) gained about %.1f pawns — well played.", san, mi, rise))
                        .build());
            }
        }
        return out;
    }

    private List<CoachMessage> passTheory(GameRecord game, AnalysisResult analysis) {
        List<CoachMessage> out = new ArrayList<>();
        for (TheoryDeviation td : analysis.theoryDeviations()) {
            String name = td.openingName().isEmpty() ? "the opening" : td.openingName();
            String eco = td.ecoCode().isEmpty() ? "" : " (" + td.ecoCode() + ")";
            out.add(CoachMessage.builder()
                    .moveIndex(td.moveIndex())
                    .type(MessageType.THEORY_NOTE)
                    .priority(MessagePriority.LOW)
                    .rawText(String.format("Around move %d you stepped away from %s%s: %s",
                            td.moveIndex(), name, eco, td.deviationNote()))
                    .build());
        }
        return out;
    }

    private List<CoachMessage> passTactics(GameRecord game, AnalysisResult analysis) {
        List<CoachMessage> out = new ArrayList<>();
        for (TacticFinding tf : analysis.missedTactics()) {
            out.add(CoachMessage.builder()
                    .moveIndex(tf.moveIndex())
                    .type(MessageType.TACTIC_MISSED)
                    .priority(MessagePriority.MEDIUM)
                    .rawText(String.format("On move %d there was a %s available: %s",
                            tf.moveIndex(), tf.motif(), tf.description()))
                    .keySquares(tf.keySquares())
                    .build());
        }
        return out;
    }

    private List<CoachMessage> batchMistakes(List<CoachMessage> msgs) {
        List<CoachMessage> mistakes = new ArrayList<>();
        List<CoachMessage> others = new ArrayList<>();
        for (CoachMessage m : msgs) {
            if (m.type() == MessageType.BLUNDER || m.type() == MessageType.INACCURACY) mistakes.add(m);
            else others.add(m);
        }
        mistakes.sort(Comparator.comparingInt(CoachMessage::moveIndex));

        List<CoachMessage> batched = new ArrayList<>();
        int i = 0;
        while (i < mistakes.size()) {
            CoachMessage head = mistakes.get(i);
            List<Integer> group = new ArrayList<>();
            group.add(head.moveIndex());
            int j = i + 1;
            while (j < mistakes.size()
                    && mistakes.get(j).type() == head.type()
                    && mistakes.get(j).moveIndex() - head.moveIndex() <= config.batchSizeWindow()) {
                group.add(mistakes.get(j).moveIndex());
                j++;
            }
            if (group.size() == 1) {
                batched.add(head);
            } else {
                String moves = joinMoves(group);
                String text = String.format("%s occurred several times nearby (%s) — worth reviewing this stretch together.",
                        head.type().label(), moves);
                batched.add(CoachMessage.builder()
                        .moveIndex(head.moveIndex())
                        .type(head.type())
                        .priority(MessagePriority.HIGH)
                        .rawText(text)
                        .relatedMoves(group)
                        .build());
            }
            i = j;
        }
        batched.addAll(others);
        return batched;
    }

    private List<CoachMessage> applyCap(List<CoachMessage> msgs) {
        List<CoachMessage> nonSummary = new ArrayList<>();
        for (CoachMessage m : msgs) if (m.type() != MessageType.SUMMARY) nonSummary.add(m);

        if (nonSummary.size() <= config.maxMessages()) return nonSummary;

        List<CoachMessage> ranked = new ArrayList<>(nonSummary);
        ranked.sort(Comparator
                .comparingInt((CoachMessage m) -> -m.priority().rank())
                .thenComparingInt(m -> m.isGlobal() ? Integer.MAX_VALUE : m.moveIndex()));

        List<CoachMessage> kept = new ArrayList<>(ranked.subList(0, config.maxMessages()));
        for (CoachMessage m : ranked) {
            if (m.type() == MessageType.BRILLIANT && !kept.contains(m)) kept.add(m);
        }
        return kept;
    }

    private List<CoachMessage> demotedFrom(List<CoachMessage> all, List<CoachMessage> kept) {
        List<CoachMessage> demoted = new ArrayList<>();
        for (CoachMessage m : all) {
            if (m.type() != MessageType.SUMMARY && !kept.contains(m)) demoted.add(m);
        }
        return demoted;
    }

    private CoachMessage composeSummary(GameRecord game, AnalysisResult analysis,
                                        List<CoachMessage> kept, List<CoachMessage> demoted) {
        StringBuilder sb = new StringBuilder();
        sb.append(resultPhrase(game)).append(". ");

        int turning = findTurningPoint(game, analysis);
        if (turning > 0) sb.append(String.format("The pivotal moment came around move %d. ", turning));

        long blunders = kept.stream().filter(m -> m.type() == MessageType.BLUNDER).count();
        long brilliants = kept.stream().filter(m -> m.type() == MessageType.BRILLIANT).count();
        if (blunders > 0 && brilliants > 0) {
            sb.append(String.format("You had %d strong moment(s) alongside %d costly mistake(s) — a balanced game. ",
                    brilliants, blunders));
        } else if (blunders > 0) {
            sb.append(String.format("Focus next time on avoiding the %d flagged mistake(s). ", blunders));
        } else if (brilliants > 0) {
            sb.append(String.format("Nice work — %d standout moment(s) and no major errors. ", brilliants));
        } else {
            sb.append("A quiet game overall; review the key positions to sharpen judgement. ");
        }

        if (!demoted.isEmpty()) {
            sb.append("Also worth reviewing: ").append(joinMoves(demoted.stream().map(CoachMessage::moveIndex).toList())).append(".");
        }

        return CoachMessage.builder()
                .moveIndex(CoachMessage.GLOBAL_MOVE_INDEX)
                .type(MessageType.SUMMARY)
                .priority(MessagePriority.HIGH)
                .rawText(sb.toString().trim())
                .build();
    }

    private boolean isUserPly(GameRecord game, int ply) {
        if (ply <= 0) return false;
        return game.userColour() == GameRecord.Colour.WHITE ? (ply % 2 == 1) : (ply % 2 == 0);
    }

    private String sanOfPly(GameRecord game, int ply) {
        List<String> sans = game.sanMoves();
        return (ply >= 1 && ply <= sans.size()) ? sans.get(ply - 1) : "?";
    }

    private String resultPhrase(GameRecord g) {
        String r = g.result();
        if ("1-0".equals(r)) return g.userColour() == GameRecord.Colour.WHITE ? "You won" : "You lost";
        if ("0-1".equals(r)) return g.userColour() == GameRecord.Colour.BLACK ? "You won" : "You lost";
        if ("1/2-1/2".equals(r)) return "The game was drawn";
        return "The game ended";
    }

    private int findTurningPoint(GameRecord game, AnalysisResult analysis) {
        double sign = game.userColour() == GameRecord.Colour.WHITE ? 1.0 : -1.0;
        List<EvalPoint> pts = analysis.evalCurve().points();
        int bestIdx = -1;
        double bestDelta = 0;
        for (int i = 1; i < pts.size(); i++) {
            double d = Math.abs(sign * (pts.get(i).scoreWhite() - pts.get(i - 1).scoreWhite()));
            if (d > bestDelta) { bestDelta = d; bestIdx = pts.get(i).moveIndex(); }
        }
        return bestIdx;
    }

    /** Placeholder hook — real square extraction needs board geometry (later module). */
    private String squareFromFenHighlight() { return ""; }

    private String joinMoves(List<Integer> moves) {
        if (moves == null || moves.isEmpty()) return "";
        StringBuilder sb = new StringBuilder();
        for (int k = 0; k < moves.size(); k++) {
            if (k > 0) sb.append(", ");
            sb.append(moves.get(k));
        }
        return sb.toString();
    }

